# Porta do servidor
PORT=3000
# Em produção, use "production" (ativa cookie seguro / HTTPS)
NODE_ENV=production
# Código exigido para criar a conta ADM no primeiro acesso (recomendado ao hospedar)
SETUP_TOKEN=troque-por-um-codigo-secreto
# Pasta onde fica o banco de dados (em hospedagem, aponte para um disco persistente)
DATA_DIR=./data
# Fuso usado para fechar a semana (segunda 00:00 a domingo 23:59)
TIMEZONE=America/Sao_Paulo
# Banco na nuvem (Turso). Se vazio, usa o arquivo local em DATA_DIR.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
